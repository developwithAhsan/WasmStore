---
import site from '../data/site.json';
import { canonical, pageSchema } from '../lib/seo';
import { arcadeCategories } from '../lib/games';
const { title, description = site.description, path = Astro.url.pathname, keywords = [], image = site.defaultSocialImage, schema = null, noindex = false, category = '' } = Astro.props;
const canonicalUrl = canonical(path);
const socialImage = new URL(image, site.url).toString();
const defaultSchema = pageSchema(title, path, description);
const schemas = schema ? [defaultSchema, ...(Array.isArray(schema) ? schema : [schema])] : [defaultSchema];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | {site.name}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex,follow' : site.seo.defaultRobots} />
    {keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
    <meta name="theme-color" content="#ffd52e" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    {schemas.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Lexend+Mega:wght@700;800&family=Pixelify+Sans:wght@600;700&family=Space+Grotesk:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/styles/portal.css" />
    <script is:inline src="/scripts/site.js" defer></script>
    <link rel="stylesheet" href="/styles/arcade-theme.css" />
  </head>
  <body data-disqus-shortname={site.disqusShortname} data-category={category}>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header arcade-site-header">
      <div class="header-inner arcade-header-inner">
        <button class="nav-toggle arcade-menu-button" type="button" aria-expanded="false" aria-controls="primary-nav" aria-label="Toggle navigation">☰</button>
        <a class="brand arcade-brand" href="/" aria-label="WasmStore home"><span class="brand-icon" aria-hidden="true">✦</span><span class="brand-copy">WASM<span>STORE</span><small>PLAY / DISCOVER / REPEAT</small></span></a>
        <nav id="primary-nav" class="primary-nav arcade-primary-nav" aria-label="Game categories">
          {arcadeCategories.map((item) => <a href={'/' + item.slug} class="arcade-nav-link" style={'--nav-accent:' + item.color}><i aria-hidden="true"></i>{item.shortName}</a>)}
        </nav>
        <form class="header-search arcade-header-search" action="/games" method="get" role="search"><label class="visually-hidden" for="header-game-search">Search games</label><span aria-hidden="true">⌕</span><input id="header-game-search" type="search" name="q" placeholder="Search games" autocomplete="off" /><kbd>/</kbd></form>
        <button class="surprise-button arcade-surprise-button" type="button" data-surprise-game><span aria-hidden="true">⚄</span> SURPRISE ME</button>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer arcade-site-footer">
      <div class="footer-grid wrap">
        <div class="footer-about"><a class="brand arcade-brand" href="/"><span class="brand-icon">✦</span><span class="brand-copy">WASM<span>STORE</span><small>PLAY / DISCOVER / REPEAT</small></span></a><p>Free browser games, classic ports and arcade nostalgia. Pick a game and get playing.</p></div>
        <div><h2>PROJECT</h2><a href="/about">About</a><a href="/contact">Contact</a></div>
        <div><h2>POLICIES</h2><a href="/privacy">Privacy</a><a href="/dmca">DMCA</a><a href="/terms">Terms</a></div>
      </div>
      <div class="footer-bottom wrap"><span>© <span data-year></span> WasmStore</span><span>INDEPENDENT BROWSER ARCADE / <a href="/sitemap-index.xml">SITEMAP</a></span></div>
    </footer>
  </body>
</html>