---
import site from '../data/site.json';
import { canonical, pageSchema } from '../lib/seo';
import { arcadeCategories, gamesForCategory } from '../lib/games';
const { title, description = site.description, path = Astro.url.pathname, keywords = [], image = site.defaultSocialImage, schema = null, noindex = false, category = '' } = Astro.props;
const canonicalUrl = canonical(path);
const socialImage = new URL(image, site.url).toString();
const defaultSchema = pageSchema(title, path, description);
const schemas = schema ? [defaultSchema, ...(Array.isArray(schema) ? schema : [schema])] : [defaultSchema];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | {site.name}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex,follow' : site.seo.defaultRobots} />
    {keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
    <meta name="theme-color" content="#ffd52e" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    {schemas.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Lexend+Mega:wght@700;800&family=Pixelify+Sans:wght@600;700&family=Space+Grotesk:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/styles/portal.css" />
    <script is:inline src="/scripts/site.js" defer></script>
    <link rel="stylesheet" href="/styles/arcade-theme.css" />
    <script is:inline src="/scripts/arcade.js" defer></script>
  </head>
  <body data-disqus-shortname={site.disqusShortname} data-category={category}>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header arcade-site-header">
      <div class="header-inner arcade-header-inner">
        <button class="nav-toggle arcade-menu-button" type="button" aria-expanded="false" aria-controls="primary-nav" aria-label="Toggle navigation">☰</button>
        <a class="brand arcade-brand" href="/" aria-label="WasmStore home"><span class="brand-icon" aria-hidden="true">✦</span><span class="brand-copy">WASM<span>STORE</span><small>PLAY / DISCOVER / REPEAT</small></span></a>
        <nav id="primary-nav" class="primary-nav arcade-primary-nav" aria-label="Game categories">
          {arcadeCategories.map((item) => <a href={'/' + item.slug} class="arcade-nav-link" style={'--nav-accent:' + item.color}><i aria-hidden="true"></i>{item.shortName}</a>)}
        </nav>
        <form class="header-search arcade-header-search" action="/games" method="get" role="search"><label class="visually-hidden" for="header-game-search">Search games</label><span aria-hidden="true">⌕</span><input id="header-game-search" type="search" name="q" placeholder="Search games" autocomplete="off" /><kbd>/</kbd></form>
        <button class="surprise-button arcade-surprise-button" type="button" data-surprise-game><span aria-hidden="true">⚄</span> SURPRISE ME</button>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer arcade-site-footer neo-footer" role="contentinfo">
      <div class="neo-footer-pixel-edge" aria-hidden="true"><span class="neo-footer-mascot">✦</span></div>
      <div class="neo-footer-inner">
        <div class="neo-footer-main">
          <section class="neo-footer-brand" aria-label="About WasmStore">
            <a class="brand arcade-brand neo-footer-logo" href="/" aria-label="WasmStore home">
              <span class="brand-icon" aria-hidden="true">✦</span>
              <span class="brand-copy">WASM<span>STORE</span><small>PLAY / DISCOVER / REPEAT</small></span>
            </a>
            <p>A free, unofficial archive that keeps old games playable in a browser. We do not own them.</p>
            {site.contactEmail && !site.contactEmail.startsWith('REPLACE_') ? <a class="neo-footer-email" href={'mailto:' + site.contactEmail}><svg aria-hidden="true" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="1" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="m4 7 8 6 8-6" fill="none" stroke="currentColor" stroke-width="1.8"/></svg><span>{site.contactEmail}</span></a> : <a class="neo-footer-email" href="/contact"><svg aria-hidden="true" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="1" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="m4 7 8 6 8-6" fill="none" stroke="currentColor" stroke-width="1.8"/></svg><span>CONTACT THE TEAM</span></a>}
          </section>
          <section class="neo-footer-systems">
            <h2 class="neo-footer-eyebrow">PICK A SYSTEM</h2>
            <nav class="neo-footer-category-grid" aria-label="Browse systems">
              {arcadeCategories.map((item) => <a class="neo-footer-category" href={'/' + item.slug} style={'--tile-accent:' + item.color} aria-label={item.name + ', ' + gamesForCategory(item).length + ' games'}>
                <span class="neo-footer-category-name">{item.name}</span>
                <span class="neo-footer-category-count">{gamesForCategory(item).length}</span>
                <span class="neo-footer-category-unit">GAMES</span>
              </a>)}
            </nav>
          </section>
        </div>
        <div class="neo-footer-divider" aria-hidden="true"></div>
        <nav class="neo-footer-legal" aria-label="Legal">
          <a href="/about">About the project</a>
          <a href="/contact">Contact</a>
          <a href="/copyright">Copyright and takedowns</a>
          <a href="/privacy">Privacy policy</a>
          <a href="/terms">Terms of service</a>
          <a href="/non-affiliation">Non-affiliation notice</a>
          <a href="/blog">Blogs</a>
        </nav>
        <p class="neo-footer-disclaimer">WasmStore does not own the games on this site and is not affiliated with, endorsed by, or sponsored by the developers, publishers, and brands associated with the games listed here. All game names and trademarks belong to their respective owners. Rights holders can request removal through our <a href="/copyright">copyright and takedown policy</a>.</p>
        <div class="neo-footer-bottom">
          <p>© <span data-year></span> WasmStore. Supported by advertising.</p>
          <span class="neo-footer-hex" aria-hidden="true">00 61 73 6D</span>
        </div>
      </div>
    </footer>
  </body>
</html>