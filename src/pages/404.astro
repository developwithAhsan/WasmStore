  <section class="not-found wrap"><div class="not-found-code">404</div><div class="eyebrow">WRONG TURN, PLAYER</div><h1>This page is <span class="gradient-text">off the map.</span></h1><p>The link may have changed, or the page may have been removed. You can return to the library or search for another title.</p><div class="hero-actions"><a class="button button-primary" href="/">Back to home →</a><a class="button button-quiet" href="/games">Browse games</a></div></section>
</BaseLayout>