---
import BaseLayout from '../../layouts/BaseLayout.astro';
import posts from '../../data/blog.json';
---
<BaseLayout title="Browser Gaming Blog & Guides" description="Read practical guides to WebAssembly, safe browser gaming, performance, touch controls, and game compatibility." path="/blog">
  <section class="page-hero"><div class="wrap"><div class="eyebrow">NOTES FROM THE WEB GAMING WORLD</div><h1>The WasmStore <span class="gradient-text">journal</span></h1><p>Clear, practical articles about browser games, web technology, and how to troubleshoot common problems.</p></div></section>
  <section class="wrap section"><div class="article-grid article-grid-large">{posts.map((post,i)=><article class="article-card article-feature"><div class="article-art" aria-hidden="true"><span>{String(i+1).padStart(2,'0')}</span><b>W<span>+</span></b></div><span class="article-kicker">{post.category} · {post.readTime} MIN READ</span><h2><a href={`/blog/${post.slug}`}>{post.title}</a></h2><p>{post.description}</p><a class="text-link" href={`/blog/${post.slug}`}>Read article ↗</a></article>)}</div></section>
</BaseLayout>