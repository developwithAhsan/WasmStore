---
import BaseLayout from '../layouts/BaseLayout.astro';
import site from '../data/site.json';
---
<BaseLayout title="Contact WasmStore" description="Report broken demo links, request corrections, suggest games, or submit a copyright concern to WasmStore." path="/contact">
  <section class="page-hero"><div class="wrap"><div class="eyebrow">SUGGESTIONS · CORRECTIONS · RIGHTS</div><h1>Get in <span class="gradient-text">touch</span></h1><p>Help improve the catalog by reporting a broken demo, an incorrect source link, or an attribution issue.</p></div></section>
  <section class="wrap contact-layout"><div class="contact-copy"><h2>What can you send us?</h2><ul class="check-list"><li>A game title and a replacement demo URL.</li><li>A correction to category, controls, or source information.</li><li>Accessibility or mobile-compatibility feedback.</li><li>A rights or takedown request with the affected page URL.</li></ul><p class="notice">Before launch, replace the contact email placeholder in <code>src/data/site.json</code>. The form opens an email draft; it does not send messages to a server.</p></div><form class="contact-form" id="contact-form" data-email={site.contactEmail}><label for="contact-name">Your name</label><input id="contact-name" name="name" autocomplete="name" required /><label for="contact-email">Email address</label><input id="contact-email" name="email" type="email" autocomplete="email" required /><label for="contact-topic">Topic</label><select id="contact-topic" name="topic"><option>Broken game link</option><option>Game suggestion</option><option>Correction or accessibility feedback</option><option>Copyright / DMCA request</option><option>Other enquiry</option></select><label for="contact-message">Message</label><textarea id="contact-message" name="message" rows="6" required placeholder="Include the game title and page URL when relevant."></textarea><button class="button button-primary" type="submit">Prepare email ↗</button><p class="form-note" id="contact-status" aria-live="polite">Your email app will open after you submit this form.</p></form></section>
</BaseLayout>