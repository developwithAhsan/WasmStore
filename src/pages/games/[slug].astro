---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GameCard from '../../components/GameCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import site from '../../data/site.json';
import { games, relatedGames } from '../../lib/games';
import { breadcrumbs } from '../../lib/seo';
export function getStaticPaths() { return games.map((game) => ({ params: { slug: game.slug }, props: { game } })); }
const { game } = Astro.props;
const related = relatedGames(game, 4);
const hasDemo = Boolean(game.demoUrl);
const crumbs = [{name:'Home',path:'/'},{name:'Games',path:'/games'},{name:game.name,path:`/games/${game.slug}`}];
const schema = [
  breadcrumbs(crumbs),
  {'@context':'https://schema.org','@type':'VideoGame',name:game.name,description:game.description,genre:game.category,gamePlatform:'Web browser',applicationCategory:'Game',url:new URL(`/games/${game.slug}`,site.url).toString(),operatingSystem:'Any modern web browser',offers:{'@type':'Offer',price:'0',priceCurrency:'USD',availability:'https://schema.org/OnlineOnly'},sameAs:game.repositoryUrl || undefined}
];
---
<BaseLayout title={game.keywords?.length ? game.keywords[0] : `${game.name} — Browser Game & Source Details`} description={game.description} path={`/games/${game.slug}`} keywords={game.keywords} schema={schema}>
  <Breadcrumbs items={crumbs} />
  <section class="game-detail wrap">
    <div class="game-detail-heading"><div><div class="eyebrow">{game.category.toUpperCase()} · COMMUNITY CATALOG</div><h1>{game.name}</h1><p>{game.description}</p><div class="tag-row">{game.tags.map(tag=><a class="tag-chip" href={`/tags/${encodeURIComponent(tag)}`}>#{tag}</a>)}</div></div><button class="button button-quiet favorite-large" data-favorite={game.slug} data-favorite-title={game.name} data-favorite-url={`/games/${game.slug}`} aria-pressed="false">♡ Save game</button></div>
    <section class="player-panel" aria-label="Game player">
      <div class="player-toolbar"><span><i class:list={['status-dot',{good:hasDemo}]}></i>{hasDemo ? 'External demo link found' : 'No demo link in source catalog'}</span><span class="player-toolbar-note">Third-party game · Availability may change</span></div>
      <div class="player-stage" id="player-stage" data-demo-url={game.demoUrl || ''}>
        {hasDemo ? <div class="player-placeholder"><div class="player-mark">W<span>+</span></div><p class="player-status" id="player-status">Ready when you are</p><h2>Launch {game.name}</h2><p>The game is hosted by a third-party provider. Choose launch to load the demo here, or open its source page if embedding is blocked.</p><div class="player-actions"><button class="button button-primary" id="launch-game" type="button">▶ Launch game</button><a class="button button-quiet" href={game.demoUrl} target="_blank" rel="noopener noreferrer">Open demo source ↗</a></div></div> : <div class="player-placeholder"><div class="player-mark">W<span>?</span></div><p class="player-status">Not yet playable here</p><h2>No verified demo link</h2><p>This catalog entry has no demo URL. Check the source project and its instructions before attempting to run or redistribute it.</p>{game.repositoryUrl && <a class="button button-primary" href={game.repositoryUrl} target="_blank" rel="noopener noreferrer">View upstream project ↗</a>}</div>}
      </div>
      <div class="player-footer"><span>Tip: click inside the player to focus keyboard input.</span><button type="button" id="fullscreen-game" class="text-button" disabled={!hasDemo}>⛶ Fullscreen</button></div>
    </section>
    <div class="detail-columns">
      <article class="detail-main">
        <section class="content-panel"><div class="panel-heading"><span>01</span><h2>About this listing</h2></div><p>{game.description}</p><p>WasmStore indexes community-reported web game ports. A demo link is a starting point, not a guarantee of current availability or permission to redistribute game files.</p></section>
        <section class="content-panel"><div class="panel-heading"><span>02</span><h2>Controls & instructions</h2></div><div class="control-row"><span class="control-icon">⌨</span><div><h3>Desktop</h3><p>{game.controls.desktop}</p></div></div><div class="control-row"><span class="control-icon">▣</span><div><h3>Mobile & touch</h3><p>{game.controls.mobile}</p></div></div><p class="muted">For exact bindings, use the instructions provided by the original demo or source repository.</p></section>
        <section class="content-panel"><div class="panel-heading"><span>03</span><h2>Source, credits & license</h2></div><p><strong>Attribution:</strong> {game.attribution}</p><p><strong>License status:</strong> {game.license}</p>{game.repositoryUrl ? <a class="button button-quiet" href={game.repositoryUrl} target="_blank" rel="noopener noreferrer">Inspect source repository ↗</a> : <p>No source repository was linked in the community catalog record.</p>}<p class="muted">WasmStore does not host this game's executable files. Before self-hosting any code or assets, review the upstream license and any separate rights in game content.</p></section>
        <section class="content-panel comments-panel"><div class="panel-heading"><span>04</span><h2>Community discussion</h2></div><div class="comments-box" data-disqus data-identifier={`wasmstore-game-${game.slug}`} data-url={new URL(`/games/${game.slug}`,site.url).toString()} data-title={game.name}><p>Comments can be enabled once the site's Disqus shortname is configured.</p><small>Each game page has a unique discussion identifier and canonical URL.</small></div></section>
      </article>
      <aside class="detail-sidebar"><section class="content-panel game-facts"><div class="panel-heading"><span>INFO</span><h2>Game details</h2></div><dl><dt>Category</dt><dd>{game.category}</dd><dt>Demo status</dt><dd>{hasDemo ? 'Demo URL listed' : 'No demo URL listed'}</dd><dt>Source</dt><dd>{game.repositoryUrl ? 'Linked' : 'Not listed'}</dd><dt>Catalog ID</dt><dd>#{game.id}</dd><dt>Keywords</dt><dd>{game.keywords?.length ? game.keywords.join(', ') : 'Ready for your SEO config'}</dd></dl></section><section class="content-panel"><div class="panel-heading"><span>NOTE</span><h2>Before you play</h2></div><ul class="check-list"><li>Use an up-to-date browser.</li><li>Check the source host's requirements.</li><li>Do not install unexpected files.</li><li>Review licensing before reuse.</li></ul></section></aside>
    </div>
  </section>
  {related.length > 0 && <section class="section wrap"><div class="section-heading"><div><div class="eyebrow">KEEP EXPLORING</div><h2>Related games</h2></div><a class="text-link" href="/games">All games →</a></div><div class="game-grid">{related.map((item)=><GameCard game={item}/>)}</div></section>}
</BaseLayout>