---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GameCard from '../../components/GameCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import site from '../../data/site.json';
import { games, relatedGames } from '../../lib/games';
import { breadcrumbs } from '../../lib/seo';
export function getStaticPaths() { return games.map((game) => ({ params: { slug: game.slug }, props: { game } })); }
const { game } = Astro.props;
const displayName = game.name.replace(/\\s+\\(\\d+\\)$/, '');
const related = relatedGames(game, 4);
const hasDemo = Boolean(game.demoUrl);
const crumbs = [{name:'Home',path:'/'},{name:'Games',path:'/games'},{name:displayName,path:`/games/${game.slug}`}];
const seoKeywords = [...new Set([displayName.toLowerCase(), `${displayName.toLowerCase()} online`, `${displayName.toLowerCase()} browser game`, `play ${displayName.toLowerCase()} in browser`, 'classic browser games', 'retro games online', 'WasmStore', ...(game.keywords || [])])];
const seoArticle = `Looking for ${displayName} online? WasmStore helps players discover browser-game listings, community ports and useful details before opening a demo. This ${displayName} browser page brings together availability information, desktop and mobile control guidance, source attribution, and related classic games in one easy-to-scan place. If a demo is listed, it is hosted by an external provider, so loading speed, device support, and embedding permissions may vary. For the best experience, use an updated browser, close unnecessary tabs, and check the original project instructions if the game does not load. Search engines and players benefit from clear, accurate game information, which is why this page distinguishes a listed demo from a guaranteed working game. WasmStore does not claim ownership of third-party game trademarks or assets. Always review upstream terms and licensing before downloading, sharing, or reusing game files.`;
const schema = [
  breadcrumbs(crumbs),
  {'@context':'https://schema.org','@type':'VideoGame',name:displayName,description:game.description,genre:game.category,gamePlatform:'Web browser',applicationCategory:'Game',url:new URL(`/games/${game.slug}`,site.url).toString(),operatingSystem:'Any modern web browser',offers:{'@type':'Offer',price:'0',priceCurrency:'USD',availability:'https://schema.org/OnlineOnly'},sameAs:game.repositoryUrl || undefined},
  {'@context':'https://schema.org','@type':'Article',headline:`${displayName} Online: Browser Game Guide, Controls & Availability`,description:`A practical ${displayName} browser-game guide with availability, controls, source details and related games.`,mainEntityOfPage:new URL(`/games/${game.slug}`,site.url).toString(),author:{'@type':'Organization',name:site.name},publisher:{'@type':'Organization',name:site.name}}
];
---
<BaseLayout title={`${displayName} Online — Browser Game, Controls & Guide`} description={`Explore ${displayName} online: browser demo availability, controls, gameplay guide, source information and related classic games on WasmStore.`} path={`/games/${game.slug}`} keywords={seoKeywords} schema={schema}>
  <Breadcrumbs items={crumbs} />
  <section class="game-detail wrap">
    <div class="game-detail-heading"><div><div class="eyebrow">{game.category.toUpperCase()} · COMMUNITY CATALOG</div><h1>{displayName}</h1><p>{game.description}</p><div class="tag-row">{game.tags.slice(0,6).map(tag=><a class="tag-chip" href={`/tags/${encodeURIComponent(tag)}`}>#{tag}</a>)}</div></div><button class="button button-quiet favorite-large" data-favorite={game.slug} data-favorite-title={displayName} data-favorite-url={`/games/${game.slug}`} aria-pressed="false">♡ Save game</button></div>

    <div class="game-play-layout">
      <section class="player-panel" aria-label="Game player">
        <div class="player-toolbar"><span><i class:list={['status-dot',{good:hasDemo}]}></i>{hasDemo ? 'External demo listed' : 'No demo link listed'}</span><span class="player-toolbar-note">Third-party availability may change</span></div>
        <div class="player-stage game-stage-compact" id="player-stage" data-demo-url={game.demoUrl || ''}>
          {hasDemo ? <iframe class="game-frame" title={`${displayName} browser game`} src={game.demoUrl} loading="eager" referrerpolicy="strict-origin-when-cross-origin" allow="fullscreen; autoplay; gamepad; clipboard-read; clipboard-write" allowfullscreen sandbox="allow-scripts allow-same-origin allow-forms allow-pointer-lock allow-popups allow-popups-to-escape-sandbox allow-downloads allow-presentation"></iframe> : <div class="player-placeholder compact-placeholder"><div class="player-mark">W<span>?</span></div><p class="player-status">Not yet playable here</p><h2>Demo not verified</h2><p>This catalog entry has no demo URL. Check the upstream project for current browser-play instructions.</p>{game.repositoryUrl && <a class="button button-primary" href={game.repositoryUrl} target="_blank" rel="noopener noreferrer">View upstream project ↗</a>}</div>}
        </div>
        <div class="player-footer"><span>{hasDemo ? 'If the embedded demo is blocked, open its source page.' : 'Availability can change as community ports are verified.'}<a class="player-source-link" href={game.demoUrl || game.repositoryUrl || '/games'} target={game.demoUrl || game.repositoryUrl ? '_blank' : undefined} rel="noopener noreferrer">{hasDemo ? ' Open demo source ↗' : game.repositoryUrl ? ' View source ↗' : ' Browse games →'}</a></span><button type="button" id="fullscreen-game" class="text-button" disabled={!hasDemo}>⛶ Fullscreen</button></div>
      </section>
      <aside class="player-side">
        <section class="content-panel compact-controls"><div class="panel-heading"><span>KEYS</span><h2>Quick controls</h2></div><div class="control-row"><span class="control-icon">⌨</span><div><h3>Desktop</h3><p>{game.controls.desktop}</p></div></div><div class="control-row"><span class="control-icon">▣</span><div><h3>Mobile</h3><p>{game.controls.mobile}</p></div></div><p class="muted">Controls depend on the original game port.</p></section>
        <section class="content-panel quick-facts"><div class="panel-heading"><span>INFO</span><h2>Game status</h2></div><p><strong>Category:</strong> {game.category}</p><p><strong>Demo:</strong> {hasDemo ? 'External link listed' : 'Not listed'}</p><p><strong>Platform:</strong> Modern web browser</p></section>
      </aside>
    </div>

    <div class="detail-columns detail-columns-reworked">
      <article class="detail-main">
        <section class="content-panel"><div class="panel-heading"><span>01</span><h2>About {displayName}</h2></div><p>{game.description}</p><p>Use this page to check the listing status, learn where the demo is hosted, and review the controls before playing. External game providers may change availability or block embedded playback.</p></section>
        <article class="content-panel seo-article"><div class="panel-heading"><span>02</span><h2>{displayName} Online: Browser Game Guide</h2></div><p>{seoArticle}</p></article>
        <section class="content-panel"><div class="panel-heading"><span>03</span><h2>{displayName} Controls & Instructions</h2></div><div class="control-row"><span class="control-icon">⌨</span><div><h3>PC keyboard controls</h3><p>{game.controls.desktop}</p></div></div><div class="control-row"><span class="control-icon">▣</span><div><h3>Mobile and touch controls</h3><p>{game.controls.mobile}</p></div></div><p class="muted">For exact key bindings, follow the instructions supplied by the original demo or source project.</p></section>
        <section class="content-panel"><div class="panel-heading"><span>04</span><h2>SEO game details</h2></div><p>This page covers search topics including <strong>{displayName} online</strong>, <strong>{displayName} browser game</strong>, gameplay availability, controls, classic games and retro browser gaming.</p><div class="tag-row">{seoKeywords.slice(0,8).map(keyword=><span class="tag-chip">{keyword}</span>)}</div><p class="muted">Game names and trademarks belong to their respective owners. WasmStore is a discovery directory and does not claim that every third-party demo is always available.</p></section>
        <section class="content-panel comments-panel"><div class="panel-heading"><span>05</span><h2>Community discussion</h2></div><div class="comments-box" data-disqus data-identifier={`wasmstore-game-${game.slug}`} data-url={new URL(`/games/${game.slug}`,site.url).toString()} data-title={displayName}><p>Community comments appear here when the site's Disqus shortname is configured.</p><small>Discussion uses a unique identifier for this game page.</small></div></section>
      </article>
      <aside class="detail-sidebar"><section class="content-panel game-facts"><div class="panel-heading"><span>FACTS</span><h2>Game details</h2></div><dl><dt>Category</dt><dd>{game.category}</dd><dt>Demo status</dt><dd>{hasDemo ? 'External demo listed' : 'No demo listed'}</dd><dt>Source</dt><dd>{game.repositoryUrl ? 'Linked' : 'Not listed'}</dd><dt>Controls</dt><dd>PC and mobile guidance</dd></dl></section><section class="content-panel"><div class="panel-heading"><span>TIP</span><h2>Before you play</h2></div><ul class="check-list"><li>Use an updated browser.</li><li>Allow keyboard focus on the player.</li><li>Open the source if embedding is blocked.</li><li>Review upstream licensing before reuse.</li></ul></section></aside>
    </div>
  </section>
  {related.length > 0 && <section class="section wrap related-section"><div class="section-heading"><div><div class="eyebrow">KEEP EXPLORING</div><h2>Related games</h2></div><a class="text-link" href="/games">All games →</a></div><div class="game-grid">{related.map((item)=><GameCard game={item}/>)}</div></section>}
</BaseLayout>