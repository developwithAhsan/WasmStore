---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GameCard from '../../components/GameCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ViceCityPlayer from '../../components/ViceCityPlayer.astro';
import site from '../../data/site.json';
import { games, relatedGames } from '../../lib/games';
import { breadcrumbs } from '../../lib/seo';
export function getStaticPaths() { return games.map((game) => ({ params: { slug: game.slug }, props: { game } })); }
const { game } = Astro.props;
const related = relatedGames(game, 4);
const hasDemo = Boolean(game.demoUrl);
const crumbs = [{name:'Home',path:'/'},{name:'Games',path:'/games'},{name:game.name,path:`/games/${game.slug}`}];
const schema = [
  breadcrumbs(crumbs),
  {'@context':'https://schema.org','@type':'VideoGame',name:game.name,description:game.description,genre:game.category,gamePlatform:'Web browser',applicationCategory:'Game',url:new URL(`/games/${game.slug}`,site.url).toString(),operatingSystem:'Any modern web browser',offers:{'@type':'Offer',price:'0',priceCurrency:'USD',availability:'https://schema.org/OnlineOnly'},sameAs:game.repositoryUrl || undefined},
  {'@context':'https://schema.org','@type':'FAQPage','mainEntity':[
    {'@type':'Question',name:`Can I play ${game.name} in my browser?`,acceptedAnswer:{'@type':'Answer',text:game.slug==='gta-vice-city'?'WasmStore includes an integrated browser runtime. First-time setup may download files into local browser storage.':hasDemo?'A demo link is listed, but availability and embedding depend on the external provider.':'A verified browser-playable build is not currently linked for this title.'}},
    {'@type':'Question',name:`Does WasmStore host the original ${game.name} game files?`,acceptedAnswer:{'@type':'Answer',text:'WasmStore is a discovery and browser-runtime project. Availability of game assets and rights to redistribute them are separate from the listing; review the linked source and applicable terms.'}},
    {'@type':'Question',name:`What controls does ${game.name} use?`,acceptedAnswer:{'@type':'Answer',text:game.controls.desktop+' '+game.controls.mobile}},
    {'@type':'Question',name:`Can I play ${game.name} on mobile?`,acceptedAnswer:{'@type':'Answer',text:game.controls.mobile+' A desktop browser is recommended when touch support has not been verified.'}}
  ]}
];
---
<BaseLayout title={game.keywords?.length ? game.keywords[0] : `${game.name} — Browser Game & Source Details`} description={game.description} path={`/games/${game.slug}`} keywords={game.keywords} schema={schema}>
  <Breadcrumbs items={crumbs} />
  <section class="game-detail wrap">
    <div class="game-detail-heading"><div><div class="eyebrow">{game.category.toUpperCase()} · COMMUNITY CATALOG</div><h1>{game.name}</h1><p>{game.description}</p><div class="tag-row">{game.tags.map(tag=><a class="tag-chip" href={`/tags/${encodeURIComponent(tag)}`}>#{tag}</a>)}</div></div><button class="button button-quiet favorite-large" data-favorite={game.slug} data-favorite-title={game.name} data-favorite-url={`/games/${game.slug}`} aria-pressed="false">♡ Save game</button></div>
    {game.slug === 'gta-vice-city' ? <ViceCityPlayer /> : (
    <section class="player-panel" aria-label="Game player">
      <div class="player-toolbar"><span><i class:list={['status-dot',{good:hasDemo}]}></i>{hasDemo ? 'Browser player available' : 'No verified browser build'}</span><span class="player-toolbar-note">Player runs here when the provider allows embedding</span></div>
      <div class="player-stage" id="player-stage" data-demo-url={game.demoUrl || ''}>
        {hasDemo ? <div class="player-placeholder"><div class="player-mark">W<span>+</span></div><p class="player-status" id="player-status">Ready when you are</p><h2>Launch {game.name}</h2><p>Choose Play to load the game in this player. Some providers block embedded playback; if that happens, a verified self-hosted build is required before this title can run entirely on WasmStore.</p><div class="player-actions"><button class="button button-primary" id="launch-game" type="button">▶ Play in this page</button></div></div> : <div class="player-placeholder"><div class="player-mark">W<span>?</span></div><p class="player-status">Not yet playable here</p><h2>No verified demo link</h2><p>A verified browser build is not linked for this title yet. It will stay marked Coming soon until a usable, properly licensed build is available.</p>{game.repositoryUrl && <a class="button button-primary" href={game.repositoryUrl} target="_blank" rel="noopener noreferrer">View upstream project ↗</a>}</div>}
      </div>
      <div class="player-footer"><span>Tip: click inside the player to focus keyboard input.</span><button type="button" id="fullscreen-game" class="text-button" disabled={!hasDemo}>⛶ Fullscreen</button></div>
    </section>
    )}
    <div class="detail-columns">
      <article class="detail-main">
        {game.slug !== 'gta-vice-city' &&         <section class="content-panel"><div class="panel-heading"><span>01</span><h2>About this listing</h2></div><p>{game.description}</p><p>WasmStore keeps the game experience on this page where embedding is permitted. A linked demo is not a guarantee of availability, and it does not grant permission to copy game files.</p></section>}
        {game.slug !== 'gta-vice-city' &&         <section class="content-panel"><div class="panel-heading"><span>02</span><h2>Controls & instructions</h2></div><div class="control-row"><span class="control-icon">⌨</span><div><h3>Desktop</h3><p>{game.controls.desktop}</p></div></div><div class="control-row"><span class="control-icon">▣</span><div><h3>Mobile & touch</h3><p>{game.controls.mobile}</p></div></div><p class="muted">For exact bindings, use the instructions provided by the original demo or source repository.</p></section>}
        <section class="content-panel"><div class="panel-heading"><span>03</span><h2>Source, credits & license</h2></div><p><strong>Attribution:</strong> {game.attribution}</p><p><strong>License status:</strong> {game.license}</p>{game.repositoryUrl ? <a class="button button-quiet" href={game.repositoryUrl} target="_blank" rel="noopener noreferrer">Inspect source repository ↗</a> : <p>No source repository was linked in the community catalog record.</p>}<p class="muted">The player uses the linked build when available. Self-hosting requires a compatible build and permission to distribute all code and game assets.</p></section>
        <section class="content-panel faq-panel"><div class="panel-heading"><span>FAQ</span><h2>Frequently asked questions</h2></div>
          <details><summary>Can I play {game.name} in my browser?</summary><p>{game.slug === 'gta-vice-city' ? 'Yes, this page uses the integrated browser runtime. The first visit may take several minutes while required files are prepared and cached.' : hasDemo ? 'A demo link is listed, but the external provider may block embedding or become unavailable.' : 'A verified browser-playable build is not linked yet, so this listing is marked as coming soon.'}</p></details>
          <details><summary>Does WasmStore host the original game files?</summary><p>WasmStore is a discovery and browser-runtime project. A listing does not itself grant permission to redistribute copyrighted code, game assets, or binaries. Review applicable licenses and asset terms.</p></details>
          <details><summary>What controls and devices are supported?</summary><p>{game.controls.desktop} {game.controls.mobile} Desktop browsers are recommended when mobile support has not been verified.</p></details>
          <details><summary>Why might the game take time to load?</summary><p>Browser ports can require downloads, local storage, modern browser features, and sufficient device memory. First-time setup may take longer than later visits.</p></details>
        </section>
        <section class="content-panel comments-panel"><div class="panel-heading"><span>04</span><h2>Community discussion</h2></div><div class="comments-box" data-disqus data-identifier={`wasmstore-game-${game.slug}`} data-url={new URL(`/games/${game.slug}`,site.url).toString()} data-title={game.name}><p>Comments can be enabled once the site's Disqus shortname is configured.</p><small>Each game page has a unique discussion identifier and canonical URL.</small></div></section>
      </article>
      <aside class="detail-sidebar"><section class="content-panel game-facts"><div class="panel-heading"><span>INFO</span><h2>Game details</h2></div><dl><dt>Category</dt><dd>{game.category}</dd><dt>Demo status</dt><dd>{game.status === 'integrated-browser-runtime' ? 'Integrated browser runtime' : hasDemo ? 'Demo URL listed' : 'No demo URL listed'}</dd><dt>Source</dt><dd>{game.repositoryUrl ? 'Linked' : 'Not listed'}</dd><dt>Catalog ID</dt><dd>#{game.id}</dd><dt>Keywords</dt><dd>{game.keywords?.length ? game.keywords.join(', ') : 'Ready for your SEO config'}</dd></dl></section><section class="content-panel"><div class="panel-heading"><span>NOTE</span><h2>Before you play</h2></div><ul class="check-list"><li>Use an up-to-date browser.</li><li>Check the source host's requirements.</li><li>Do not install unexpected files.</li><li>Review licensing before reuse.</li></ul></section></aside>
    </div>
  </section>
  {related.length > 0 && <section class="section wrap"><div class="section-heading"><div><div class="eyebrow">KEEP EXPLORING</div><h2>Related games</h2></div><a class="text-link" href="/games">All games →</a></div><div class="game-grid">{related.map((item)=><GameCard game={item}/>)}</div></section>}
<style>
  .faq-panel details{border-top:1px solid rgba(255,255,255,.09);padding:14px 0}
  .faq-panel details:last-child{border-bottom:1px solid rgba(255,255,255,.09)}
  .faq-panel summary{cursor:pointer;font-weight:650;line-height:1.5;list-style:none;display:flex;justify-content:space-between;gap:14px}
  .faq-panel summary::-webkit-details-marker{display:none}
  .faq-panel summary::after{content:"+";color:#b7a9ff;font-size:1.2rem}
  .faq-panel details[open] summary::after{content:"−"}
  .faq-panel details p{margin:10px 0 0;color:var(--muted,#aaaab9);line-height:1.7}
  .comments-box{min-height:110px}
  .comments-box small{display:block;margin-top:8px;color:var(--muted,#aaaab9)}
  @media(max-width:600px){.faq-panel summary{font-size:.95rem}}
</style>
</BaseLayout>