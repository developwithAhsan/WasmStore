---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GameCard from '../../components/GameCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import site from '../../data/site.json';
import { games, relatedGames } from '../../lib/games';
import { breadcrumbs } from '../../lib/seo';

export function getStaticPaths() {
  return games.map((game) => ({ params: { slug: game.slug }, props: { game } }));
}
const { game } = Astro.props;
const displayName = game.name.replace(/\s+\(\d+\)$/, '');
const related = relatedGames(game, 4);
const hasDemo = Boolean(game.demoUrl);
const titleText = displayName.toUpperCase();
const crumbs = [{ name: 'Home', path: '/' }, { name: 'PC games', path: '/games' }, { name: displayName, path: '/games/' + game.slug }];
const pageUrl = new URL('/games/' + game.slug, site.url).toString();
const cover = game.thumbnailUrl || site.defaultSocialImage;
const faqItems = [
  { q: 'Do I need to download the game to play in my browser?', a: 'If a browser demo is listed, you can try it without installing a desktop game. The demo is hosted by its provider, and availability or browser requirements may vary.' },
  { q: 'Are the original radio stations and audio included?', a: 'Audio features depend on the specific port and its assets. This listing does not guarantee that original radio stations, music, or every sound file is included.' },
  { q: 'How do I save my progress?', a: 'Save support depends on the game port. Check its in-game menu and the upstream project instructions; browser storage may be cleared by private browsing or site-data settings.' },
  { q: 'Can I play with a controller or gamepad?', a: 'Some browser ports support gamepads, but support varies. Connect your controller before starting and check the game or source project controls.' },
  { q: 'Can I enter classic cheat codes?', a: 'Cheat-code support depends on the specific game and port. Use codes documented by the original game or its upstream project.' },
  { q: 'Is the site safe to use?', a: 'WasmStore is a game discovery directory. Listed demos may be hosted by third parties, so check the destination and review its privacy and security information before using it.' }
];
const schema = [
  breadcrumbs(crumbs),
  { '@context': 'https://schema.org', '@type': 'VideoGame', name: displayName, description: game.description, genre: game.category, gamePlatform: 'Web browser', applicationCategory: 'Game', url: pageUrl, image: new URL(cover, site.url).toString(), operatingSystem: 'Any modern web browser', offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD', availability: 'https://schema.org/OnlineOnly' }, sameAs: game.repositoryUrl || undefined },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqItems.map((item) => ({ '@type': 'Question', name: item.q, acceptedAnswer: { '@type': 'Answer', text: item.a } })) }
];
const shortTitle = 'Play ' + displayName + ' Online Free in Browser | No Download';
const description = 'Play or explore ' + displayName + ' in your browser. Check demo availability, controls, game details, FAQs and related PC games on WasmStore.';
---
<BaseLayout title={shortTitle} description={description} path={'/games/' + game.slug} image={cover} keywords={[displayName.toLowerCase() + ' online', 'play ' + displayName.toLowerCase() + ' in browser', displayName.toLowerCase() + ' browser game', 'free browser games', ...(game.keywords || [])]} schema={schema}>
  <Breadcrumbs items={crumbs} />
  <div class="arcade-page wrap">
    <section class="arcade-hero-grid" aria-label={displayName + ' game and information'}>
      <div class="arcade-hero-card">
        <div class="arcade-topbar"><span>RE3 / WASMSTORE</span><span class="arcade-ready"><i></i>{hasDemo ? 'READY' : 'CATALOG ENTRY'}</span></div>
        <div class="arcade-player-inner">
          <div class="arcade-promo">
            <div class="arcade-pixel-label">FREE PLAY</div>
            <p>The original browser-game experience. Explore the listing, check controls, and launch the available community demo.</p>
            <a class="arcade-play-button" href="#actual-game" aria-label={'Go to ' + displayName + ' game player'}><span aria-hidden="true">▶</span> PLAY {titleText}</a>
            <div class="arcade-tiny-note">{hasDemo ? 'BROWSER DEMO LISTED · EXTERNAL HOST' : 'DEMO NOT CURRENTLY LISTED'}</div>
          </div>
          <div class="arcade-cover-wrap">
            {game.thumbnailUrl ? <img class="arcade-cover" src={game.thumbnailUrl} alt={displayName + ' game cover and thumbnail'} width="640" height="360" fetchpriority="high" decoding="async" /> : <div class="arcade-cover arcade-cover-fallback" role="img" aria-label={displayName + ' game artwork placeholder'}><span>{displayName.slice(0, 2).toUpperCase()}</span></div>}
          </div>
        </div>
        <div class="arcade-controlbar"><div class="arcade-ticks" aria-hidden="true">{Array.from({ length: 24 }, (_, i) => <i class:list={{ active: i < (hasDemo ? 18 : 5) }} />)}</div><div class="arcade-toolbar-actions"><a href="#game-details" class="arcade-tool-button">▣ SAVES</a><button type="button" class="arcade-tool-button muted-tool" disabled>ϟ CHEATS</button><button type="button" id="fullscreen-game" class="arcade-tool-button yellow-tool" disabled={!hasDemo}>⛶ FULLSCREEN</button></div></div>
      </div>
      <aside class="arcade-info-card" id="game-details">
        <div class="arcade-info-top"><span>PC GAME</span><strong>WEB</strong></div>
        <div class="arcade-info-body">
          <h1>{titleText}</h1>
          <div class="arcade-tags"><span>{game.category.toUpperCase()}</span><span>OPEN-WORLD ACTION</span></div>
          <div class="arcade-mono-heading">ABOUT THE ORIGINAL</div>
          <p class="arcade-description">{game.description}</p>
          <div class="arcade-specs">
            <div><b>Developer</b><span>See original project</span></div>
            <div><b>Publisher</b><span>Original rights holders</span></div>
            <div><b>Released</b><span>See game source</span></div>
            <div><b>Genre</b><span>{game.category}</span></div>
            <div><b>Setting</b><span>Varies by title</span></div>
            <div><b>Players</b><span>Single-player / port dependent</span></div>
          </div>
        </div>
        <div class="arcade-info-bottom"><span>MORE PC GAMES</span><a href="/games" aria-label="See all games">↗</a></div>
      </aside>
    </section>

    <section class="arcade-live-player" id="actual-game" aria-label={displayName + ' browser player'}>
      <div class="arcade-section-heading"><h2>PLAY {titleText}</h2><span>{hasDemo ? 'EXTERNAL DEMO' : 'NOT AVAILABLE'}</span></div>
      <div class="arcade-frame-shell" id="player-stage" data-demo-url={game.demoUrl || ''}>
        {hasDemo ? <iframe class="game-frame" title={displayName + ' browser game'} src={game.demoUrl} loading="eager" referrerpolicy="strict-origin-when-cross-origin" allow="fullscreen; autoplay; gamepad; clipboard-read; clipboard-write" allowfullscreen sandbox="allow-scripts allow-same-origin allow-forms allow-pointer-lock allow-popups allow-popups-to-escape-sandbox allow-downloads allow-presentation"></iframe> : <div class="arcade-unavailable"><b>DEMO NOT LISTED</b><p>This catalog entry does not currently include a playable browser URL. Check the upstream project for instructions.</p>{game.repositoryUrl && <a class="arcade-outline-button" href={game.repositoryUrl} target="_blank" rel="noopener noreferrer">OPEN SOURCE PROJECT ↗</a>}</div>}
      </div>
      <div class="arcade-player-foot"><span>{hasDemo ? 'If the embed is blocked, open the demo provider directly.' : 'Browser availability has not been verified for this entry.'}</span>{hasDemo && <a href={game.demoUrl} target="_blank" rel="noopener noreferrer">OPEN DEMO ↗</a>}</div>
    </section>

    <section class="arcade-faq-section" aria-labelledby="faq-title">
      <div class="arcade-section-heading"><h2 id="faq-title">Frequently asked questions</h2><span>QUICK ANSWERS</span></div>
      <div class="arcade-faq-list">{faqItems.map((item, index) => <details class="arcade-faq-row" open={index === 0}><summary><span>{item.q}</span><b aria-hidden="true">+</b></summary><div class="arcade-faq-answer"><p>{item.a}</p></div></details>)}</div>
    </section>

    {related.length > 0 && <section class="arcade-more-section" aria-labelledby="more-games-title">
      <div class="arcade-more-heading"><h2 id="more-games-title">MORE PC GAMES</h2><a href="/games" class="arcade-outline-button">SEE ALL PC GAMES →</a></div>
      <div class="arcade-more-grid">{related.map((item) => <GameCard game={item} />)}</div>
    </section>}
  </div>
</BaseLayout>