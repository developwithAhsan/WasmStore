---
import BaseLayout from '../layouts/BaseLayout.astro';
import GameCard from '../components/GameCard.astro';
import { games, categories } from '../lib/games';
import site from '../data/site.json';
const featuredSlugs = ['gta-3-3','gta-vice-city-2','gta-v','the-simpsons-hit-and-run-web-port'];
const featured = featuredSlugs.map((slug) => games.find((game) => game.slug === slug)).filter((game): game is NonNullable<typeof game> => Boolean(game));
const searchText = (g: (typeof games)[number]) => [g.name,g.category,g.tags.join(' '),g.slug].join(' ').toLowerCase();
---
<BaseLayout title="WasmStore — Classic Games Library" description="Browse classic games, community browser ports, and game collections in WasmStore." path="/" schema={[{ '@context':'https://schema.org','@type':'WebSite',name:site.name,url:site.url,potentialAction:{'@type':'SearchAction',target:site.url+'/games?q={search_term_string}', 'query-input':'required name=search_term_string'}}]}>
  <div class="home-library wrap">
    <section class="home-categories" id="categories" aria-labelledby="category-title">
      <div class="library-heading"><span class="pixel-kicker">PICK YOUR PLAYSTYLE</span><h1 id="category-title">CATEGORIES</h1></div>
      <div class="category-grid">{categories.map((category, i) => <a class="category-tile" href={`/categories/${encodeURIComponent(category.toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,''))}`}><span class="category-number">{String(i+1).padStart(2,'0')}</span><strong>{category}</strong><span>{games.filter((g) => g.category === category).length} GAMES <b>↗</b></span></a>)}</div>
    </section>
    <section class="home-games" id="games" aria-labelledby="games-title">
      <div class="library-heading"><span class="pixel-kicker">THE ARCADE SHELF</span><h2 id="games-title">GAMES</h2><p>Choose a classic and open its game page.</p></div>
      <div class="game-grid home-game-grid">{featured.map((game) => <div data-library-game data-slug={game.slug} data-search={searchText(game)}><GameCard game={game} /></div>)}</div>
      <div class="game-grid home-game-grid">
        <article class="game-card">
          <a class="game-art" href="/games/gta-chinatown-wars" aria-label="GTA Chinatown Wars coming soon"><span class="art-orbit orbit-one"></span><span class="art-orbit orbit-two"></span><span class="art-initial" aria-hidden="true">CTW</span><span class="art-category">Grand Theft Auto</span></a>
          <div class="game-card-body"><div class="game-card-meta"><span>Action · Adventure</span><span class="availability">Coming soon</span></div><h3><a href="/games/gta-chinatown-wars">GTA: Chinatown Wars</a></h3><p>Catalog placeholder. A verified browser-playable version has not been confirmed yet.</p><div class="card-actions"><a class="button button-small button-primary" href="/games/gta-chinatown-wars">View status <span>→</span></a></div></div>
        </article>
      </div>
      <div class="home-more"><a class="button button-primary" href="/games">Browse all games <span>→</span></a></div>
    </section>
  </div>
</BaseLayout>