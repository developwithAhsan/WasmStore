---
import BaseLayout from '../layouts/BaseLayout.astro';
import GameCard from '../components/GameCard.astro';
import { games, arcadeCategories, gamesForCategory, categoryForGame } from '../lib/games';
import site from '../data/site.json';

const categoryCards = arcadeCategories.map((category) => ({ ...category, games: gamesForCategory(category) }));
const startGames = [...games].sort((a, b) => Number(Boolean(b.demoUrl)) - Number(Boolean(a.demoUrl))).slice(0, 14);
const homeSchema = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: site.name, url: site.url, potentialAction: { '@type': 'SearchAction', target: site.url + '/games?q={search_term_string}', 'query-input': 'required name=search_term_string' } },
  { '@context': 'https://schema.org', '@type': 'ItemList', name: 'Five browser game categories', itemListElement: categoryCards.map((category, index) => ({ '@type': 'ListItem', position: index + 1, name: category.name, url: new URL('/' + category.slug, site.url).toString() })) }
];
---
<BaseLayout title="Play Free Browser Games Online | No Download" description={`Play ${games.length} free browser games online. Discover classics, action, arcade, racing and puzzle games — no install or account required.`} path="/" schema={homeSchema}>
  <div class="arcade-home wrap">
    <section class="arcade-home-hero" aria-label="Featured browser games">
      <div class="arcade-typewriter" aria-label="Featured games">
        <span class="arcade-typewriter-text" data-game-typewriter aria-live="polite">PLAY GTA 5 IN YOUR BROWSER</span><span class="arcade-typewriter-cursor" aria-hidden="true"></span>
      </div>
    </section>
    <section class="arcade-category-section" aria-label="Game categories">
      <div class="arcade-category-grid">
        {categoryCards.map((category) => <a class="arcade-category-card" href={'/' + category.slug} data-category={category.key} style={'--accent:' + category.color} aria-label={'Browse ' + category.name + ', ' + category.games.length + ' games'}>
          <span class="arcade-card-number">{category.key.toUpperCase()}</span><h3>{category.name}</h3><p>{category.description}</p>
          <div class="arcade-category-bottom"><div class="arcade-mini-covers" aria-hidden="true">{category.games.slice(0,3).map((game) => game.thumbnailUrl ? <img src={game.thumbnailUrl} alt="" loading="lazy" width="42" height="28" /> : <span>{game.name.slice(0,1)}</span>)}</div><div class="arcade-category-count"><strong>{category.games.length}</strong><small>GAMES</small></div></div><span class="arcade-card-arrow" aria-hidden="true">↗</span>
        </a>)}
      </div>
    </section>
    <section class="arcade-start-section" aria-labelledby="start-title">
      <div class="arcade-section-title"><div><span class="arcade-kicker">02 / YOUR NEXT CLICK</span><h2 id="start-title" class="arcade-black-label">START HERE</h2></div><div class="arcade-carousel-controls"><button type="button" class="arcade-arrow" data-carousel-prev aria-label="Scroll games left" disabled>←</button><button type="button" class="arcade-arrow" data-carousel-next aria-label="Scroll games right">→</button></div></div>
      <div class="arcade-game-carousel" data-game-carousel>
        {startGames.map((game) => { const category = categoryForGame(game); return <div class="arcade-home-game" style={'--accent:' + category.color}><GameCard game={game} compact /></div>; })}
      </div>
    </section>
    <section class="arcade-new-section" aria-labelledby="new-title">
      <div class="arcade-section-title"><div><span class="arcade-kicker">03 / MORE TO EXPLORE</span><h2 id="new-title" class="arcade-black-label">READY TO PLAY</h2></div><a class="arcade-text-link" href="/games">Browse all games ↗</a></div>
      <div class="arcade-feature-grid">{startGames.slice(0,4).map((game) => { const category = categoryForGame(game); return <div class="arcade-home-game" style={'--accent:' + category.color}><GameCard game={game} compact /></div>; })}</div>
    </section>
  </div>
</BaseLayout>
