---
import BaseLayout from '../layouts/BaseLayout.astro';
import GameCard from '../components/GameCard.astro';
import { games } from '../lib/games';
import site from '../data/site.json';

const bySlug = (slug: string) => games.find((game) => game.slug === slug);
const classicGames = ['gta-3-3','gta-vice-city-2','gta-v','the-simpsons-hit-and-run-web-port'].map(bySlug).filter(Boolean);
const viceCityGames = ['gta-vice-city-2'].map(bySlug).filter(Boolean);
const arcadeGames = games.filter((game) => game.category === 'Arcade').slice(0, 3);
const flashGames = games.filter((game) => game.category === 'Puzzle' || game.category === 'Platformer').slice(0, 3);
const searchText = (g: (typeof games)[number]) => [g.name,g.category,g.tags.join(' '),g.slug].join(' ').toLowerCase();
const homeSchema = [
  {'@context':'https://schema.org','@type':'WebSite',name:site.name,url:site.url,potentialAction:{'@type':'SearchAction',target:site.url+'/games?q={search_term_string}', 'query-input':'required name=search_term_string'}},
  {'@context':'https://schema.org','@type':'ItemList',name:'Classic browser games',itemListElement:classicGames.map((g,index)=>({'@type':'ListItem',position:index+1,url:new URL('/games/'+g.slug,site.url).toString(),name:g.name.replace(/\s+\(\d+\)$/,'')}))}
];
---
<BaseLayout title="WasmStore — Classic, Arcade & Browser Games" description="Discover classic games, arcade favorites, Flash-style browser games and GTA Vice City community ports in the WasmStore game library." path="/" schema={homeSchema}>
  <div class="home-library wrap">
    <section class="home-games home-section section-classic" id="classic-games" aria-labelledby="classic-title">
      <div class="library-heading"><span class="pixel-kicker">01 / THE CLASSICS</span><h1 id="classic-title">CLASSIC GAMES</h1><p>Legendary worlds and familiar favorites, collected in one place.</p></div>
      <div class="game-grid home-game-grid">{classicGames.map((game) => <div data-library-game data-slug={game.slug} data-search={searchText(game)}><GameCard game={game} /></div>)}</div>
      <div class="home-more"><a class="button button-primary" href="/games">Explore all games <span>→</span></a></div>
    </section>
    <section class="home-games home-section section-arcade" id="arcade-games" aria-labelledby="arcade-title">
      <div class="library-heading"><span class="pixel-kicker">02 / QUICK PLAY</span><h2 id="arcade-title">ARCADE GAMES</h2><p>Pick-up-and-play arcade classics and browser ports.</p></div>
      <div class="game-grid home-game-grid">{arcadeGames.map((game) => <div data-library-game data-slug={game.slug} data-search={searchText(game)}><GameCard game={game} /></div>)}</div>
      <div class="home-more"><a class="button button-quiet" href="/categories/arcade">Browse arcade games <span>→</span></a></div>
    </section>
    <section class="home-games home-section section-flash" id="flash-games" aria-labelledby="flash-title">
      <div class="library-heading"><span class="pixel-kicker">03 / WEB-GAME NOSTALGIA</span><h2 id="flash-title">FLASH GAMES</h2><p>Classic browser-game nostalgia. This collection currently highlights lightweight puzzle and platform games while legacy Flash entries are being verified.</p></div>
      <div class="game-grid home-game-grid">{flashGames.map((game) => <div data-library-game data-slug={game.slug} data-search={searchText(game)}><GameCard game={game} /></div>)}</div>
      <div class="home-more"><a class="button button-quiet" href="/games">Find more browser games <span>→</span></a></div>
    </section>
    <section class="home-games home-section section-vice-city" id="gta-vice-city" aria-labelledby="vice-city-title">
      <div class="library-heading"><span class="pixel-kicker">04 / GRAND THEFT AUTO</span><h2 id="vice-city-title">GTA VICE CITY</h2><p>Explore the neon-lit Vice City browser-port listing and its availability details.</p></div>
      <div class="game-grid home-game-grid">{viceCityGames.map((game) => <div data-library-game data-slug={game.slug} data-search={searchText(game)}><GameCard game={game} /></div>)}</div>
    </section>
  </div>
</BaseLayout>