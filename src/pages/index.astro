---
import BaseLayout from '../layouts/BaseLayout.astro';
import GameCard from '../components/GameCard.astro';
import { games } from '../lib/games';
import site from '../data/site.json';
const featured = games;
---
<BaseLayout title="WasmStore — Six Games. One Browser Arcade" description="Explore six curated browser-game listings: GTA 5, GTA 3, GTA Vice City, GTA: Chinatown Wars, Minecraft, and The Simpsons: Hit & Run." path="/" schema={[{ '@context':'https://schema.org','@type':'WebSite',name:'WasmStore',url:site.url,potentialAction:{'@type':'SearchAction',target:site.url+'/games?q={search_term_string}', 'query-input':'required name=search_term_string'}}]}>
  <section class="hero wrap">
    <div class="hero-copy"><div class="eyebrow"><span class="live-dot"></span> A LIBRARY FOR THE WEB GAMING ERA</div><h1>Big worlds.<br /><span class="gradient-text">One browser.</span></h1><p>Explore a focused collection of six requested classics, with demo links and clear availability notes for each title.</p>
      <div class="hero-actions"><a class="button button-primary" href="/games">Explore all games <span>→</span></a><a class="button button-quiet" href="#featured">Choose a game ↓</a></div>
      <div class="hero-stats"><div><strong>{games.length}</strong><span>catalog listings</span></div><div><strong>6</strong><span>curated titles</span></div><div><strong>1</strong><span>arcade collection</span></div></div>
    </div>
    <div class="hero-visual" aria-label="Abstract WasmStore gaming artwork"><div class="hero-glow"></div><div class="hero-console"><div class="console-top"><span class="console-led"></span><span>WASMSTORE / LIBRARY</span><span>01—06</span></div><div class="console-screen"><div class="screen-grid"></div><div class="screen-symbol">W<span>+</span></div><div class="screen-caption">DISCOVER YOUR NEXT PLAY</div></div><div class="console-bottom"><span>WEB · WASM · HTML5</span><span class="console-pill">PRESS START ↗</span></div></div><div class="floating-chip chip-a">⌘  Keyboard & mouse</div><div class="floating-chip chip-b">◉ Community ports</div></div>
  </section>
  <section class="section wrap" id="featured"><div class="section-heading"><div><div class="eyebrow">HANDPICKED STARTING POINTS</div><h2>Pick your game</h2><p>Six handpicked titles. Pick one and jump in.</p></div><a class="text-link" href="/games">All six games <span>→</span></a></div><div class="game-grid">{featured.map((game) => <GameCard game={game} />)}</div></section>
  <section class="section wrap" id="recently-played" data-recent-section hidden><div class="section-heading"><div><div class="eyebrow">PICK UP WHERE YOU LEFT OFF</div><h2>Recently played on this device</h2><p>Your recent list stays in this browser only.</p></div><button class="text-button" type="button" data-clear-recent>Clear history</button></div><div class="compact-list" data-recent-list></div></section>
</BaseLayout>