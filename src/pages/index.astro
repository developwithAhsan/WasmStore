---
import BaseLayout from '../layouts/BaseLayout.astro';
import GameCard from '../components/GameCard.astro';
import { games, playableGames, categories } from '../lib/games';
import blog from '../data/blog.json';
const pick = (terms: string[]) => terms.map((term) => games.find((g) => g.name.toLowerCase().includes(term.toLowerCase()))).filter(Boolean);
const featured = [...pick(['Grand Theft Auto III','Doom 3','Celeste','Balatro','Cave Story','Doom']) , ...playableGames].filter((g, i, a) => g && a.findIndex((x) => x.slug === g.slug) === i).slice(0, 6);
const trending = playableGames.slice(10, 16);
const recent = [...games].slice(-6).reverse();
---
<BaseLayout title="Play Browser Games Online — Explore WebAssembly Ports" description="Discover 582 community-listed browser game projects, explore playable demos, find source repositories, and read practical guides to WebAssembly gaming." path="/" schema={[{ '@context':'https://schema.org','@type':'WebSite',name:'WasmStore',url:'https://wasmstore.netlify.app',potentialAction:{'@type':'SearchAction',target:'https://wasmstore.netlify.app/games?q={search_term_string}', 'query-input':'required name=search_term_string'}}]}>
  <section class="hero wrap">
    <div class="hero-copy"><div class="eyebrow"><span class="live-dot"></span> A LIBRARY FOR THE WEB GAMING ERA</div><h1>Big worlds.<br /><span class="gradient-text">One browser.</span></h1><p>Find browser-playable classics, community game ports, indie experiments, and useful guides—all in one organized discovery library.</p>
      <div class="hero-actions"><a class="button button-primary" href="/games">Explore all games <span>→</span></a><a class="button button-quiet" href="/categories">Browse categories</a></div>
      <div class="hero-stats"><div><strong>{games.length}</strong><span>catalog listings</span></div><div><strong>{playableGames.length}</strong><span>demo links listed</span></div><div><strong>{categories.length}</strong><span>categories</span></div></div>
    </div>
    <div class="hero-visual" aria-label="Abstract WasmStore gaming artwork"><div class="hero-glow"></div><div class="hero-console"><div class="console-top"><span class="console-led"></span><span>WASMSTORE / LIBRARY</span><span>01—582</span></div><div class="console-screen"><div class="screen-grid"></div><div class="screen-symbol">W<span>+</span></div><div class="screen-caption">DISCOVER YOUR NEXT PLAY</div></div><div class="console-bottom"><span>WEB · WASM · HTML5</span><span class="console-pill">PRESS START ↗</span></div></div><div class="floating-chip chip-a">⌘  Keyboard & mouse</div><div class="floating-chip chip-b">◉ Community ports</div></div>
  </section>
  <section class="trust-strip"><div class="wrap trust-inner"><span>DISCOVER</span><span>COMPARE</span><span>PLAY WHERE AVAILABLE</span><span>LEARN</span><span>SUPPORT THE ORIGINAL CREATORS</span></div></section>
  <section class="section wrap" id="featured"><div class="section-heading"><div><div class="eyebrow">HANDPICKED STARTING POINTS</div><h2>Featured discoveries</h2><p>Explore a few recognizable projects from the wider web-game community.</p></div><a class="text-link" href="/games">Browse library <span>→</span></a></div><div class="game-grid">{featured.map((game) => <GameCard game={game} />)}</div></section>
  <section class="section category-section" id="categories"><div class="wrap"><div class="section-heading"><div><div class="eyebrow">FIND YOUR GENRE</div><h2>Browse by category</h2><p>Start with a genre, then check each listing for its demo and source.</p></div><a class="text-link" href="/categories">All categories →</a></div><div class="category-grid">{categories.map((category, i) => <a class="category-tile" href={`/categories/${encodeURIComponent(category.toLowerCase())}`}><span class="category-number">{String(i+1).padStart(2,'0')}</span><strong>{category}</strong><span>{games.filter((g) => g.category === category).length} listings <b>↗</b></span></a>)}</div></div></section>
  <section class="section wrap"><div class="section-heading"><div><div class="eyebrow">DEMO LINKS IN THE CATALOG</div><h2>Ready to explore</h2><p>These entries have a demo link in the source catalog. External availability and embedding can change.</p></div><a class="text-link" href="/games?status=demo">See demo listings →</a></div><div class="game-grid">{trending.map((game) => <GameCard game={game} />)}</div></section>
  <section class="section latest-section"><div class="wrap"><div class="section-heading"><div><div class="eyebrow">NEW TO THIS DIRECTORY</div><h2>Recently added to the catalog</h2><p>Newly listed here does not necessarily mean a new game release.</p></div></div><div class="compact-list">{recent.map((game) => <a class="compact-game" href={`/games/${game.slug}`}><span class="compact-initial">{game.name.slice(0,1)}</span><span><strong>{game.name}</strong><small>{game.category} · {game.demoUrl ? 'Demo link listed' : 'Source discovery'}</small></span><b>↗</b></a>)}</div></div></section>
  <section class="section wrap"><div class="section-heading"><div><div class="eyebrow">PLAY SMARTER</div><h2>Guides for better browser gaming</h2><p>Clear advice about compatibility, performance, controls, and safer browsing.</p></div><a class="text-link" href="/blog">All articles →</a></div><div class="article-grid">{blog.slice(0,3).map((post) => <article class="article-card"><span class="article-kicker">{post.category} · {post.readTime} MIN READ</span><h3><a href={`/blog/${post.slug}`}>{post.title}</a></h3><p>{post.description}</p><a class="text-link" href={`/blog/${post.slug}`}>Read article ↗</a></article>)}</div></section>
  <section class="cta-band wrap"><div><div class="eyebrow">A CATALOG, NOT A PROMISE</div><h2>Know what you're launching.</h2><p>Each listing shows whether a demo link or source repository was found. Always check compatibility and the project's license.</p></div><a class="button button-primary" href="/games">Explore the catalog →</a></section>
</BaseLayout>